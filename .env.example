AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

VERA_DB=./data/vera.db
VERA_DATA_DIR=./data
VERA_VECTOR_BACKEND=chroma
VERA_CHROMA_DIR=./data/chroma
VERA_RETRIEVAL_MODE=graph_primary
VERA_GRAPH_HOPS=3
VERA_QUOTE_TOP_K=8
VERA_WEAVER_LLM_CHUNKS=16
VERA_REFUSE_THRESHOLD=0.35
VERA_NEAR_DUPE_THRESHOLD=0.85
VERA_MAX_UPLOAD_FILES=100
VERA_MAX_FILE_MB=100
VERA_URL_MAX_PAGES=20
VERA_URL_MAX_DEPTH=1
# Optional — real SharePoint via Microsoft Graph (Sites.Read.All + Files.Read.All)
VERA_MS_TENANT_ID=
VERA_MS_CLIENT_ID=
VERA_MS_CLIENT_SECRET=
VERA_EMBED_PRICE_PER_1M_TOKENS=0.02
VERA_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500
VERA_WIDGET_PUBLIC_ORIGIN=http://localhost:5173
VERA_PUBLIC_REQUIRE_ORIGIN=false
VERA_PUBLIC_RATE_LIMIT_PER_MIN=60
VERA_MOCK_LLM=false
VERA_LOG_LEVEL=INFO
